NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=info
# Vazio: /status desabilitado (404). Configurar token aleatório de pelo menos 32 caracteres.
STATUS_TOKEN=
SYNC_ENABLED=false
SYNC_INTERVAL_MS=60000
DEPENDENCY_CHECK_INTERVAL_MS=60000
DEPENDENCY_RETRY_MAX_MS=300000
SHUTDOWN_TIMEOUT_MS=20000

# Sem senha: diagnóstico Olos não tenta conexão. Usar secret protegido no Dokploy.
OLOS_HOST=10.196.234.11
OLOS_PORT=1433
OLOS_DATABASE=ExportDataV3
OLOS_USER=OEC
OLOS_PASSWORD=
OLOS_ENCRYPT=true
OLOS_TRUST_SERVER_CERTIFICATE=false
OLOS_TLS_MIN_VERSION=TLSv1.2
ALLOW_INSECURE_DB_TLS=false
OLOS_POOL_MAX=2
OLOS_CONNECT_TIMEOUT_MS=5000
OLOS_REQUEST_TIMEOUT_MS=5000
OLOS_IDLE_TIMEOUT_MS=30000

# Sem host/usuário/senha: diagnóstico PostgreSQL não tenta conexão.
PG_HOST=
PG_PORT=5432
PG_DATABASE=hubspot_olos
PG_USER=
PG_PASSWORD=
PG_SCHEMA=olos_export
PG_SSL_MODE=verify-full
# PEM da CA, opcional; não desabilitar validação para contornar certificado incorreto.
PG_SSL_CA=
PG_POOL_MAX=3
PG_CONNECT_TIMEOUT_MS=5000
PG_QUERY_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000

# Preparação da persistência; o boot não instancia o adaptador nem habilita consumo.
PERSISTENCE_MAX_RECORDS=1000
PERSISTENCE_MAX_BYTES=4194304
PERSISTENCE_CHUNK_SIZE=200
PERSISTENCE_LEASE_MS=60000
